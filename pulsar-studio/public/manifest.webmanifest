{
  "name": "Pulsar Studio — Beat Lab",
  "short_name": "Pulsar",
  "description": "A browser-native beat lab: step sequencer, piano roll, drum synths, mixer and an Arena-powered co-writer.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#06070a",
  "theme_color": "#06070a",
  "categories": ["music", "productivity", "entertainment"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    { "name": "Studio", "url": "/studio", "description": "Open the sequencer" },
    { "name": "AI Composer", "url": "/composer", "description": "Generate an arrangement" },
    { "name": "Projects", "url": "/projects", "description": "Browse sessions" }
  ]
